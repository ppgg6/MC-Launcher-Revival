<Window x:Class="MC_Launcher_Revival.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="X 启动器" Height="820" Width="1280" MinHeight="720" MinWidth="1020"
 WindowStartupLocation="CenterScreen"
 Background="#F5F6F8" Foreground="#1F2430"
 FontFamily="Microsoft YaHei UI, Segoe UI" TextOptions.TextFormattingMode="Display">

 <Window.Resources>
  <SolidColorBrush x:Key="Primary" Color="#3A6FE0"/>
  <SolidColorBrush x:Key="PrimarySoft" Color="#EAF1FE"/>
  <SolidColorBrush x:Key="Line" Color="#E9ECF2"/>
  <SolidColorBrush x:Key="Muted" Color="#78838F"/>

  <!-- 普通按钮 -->
  <Style x:Key="BaseButton" TargetType="Button">
   <Setter Property="Foreground" Value="#333B4A"/>
   <Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#E1E6EE"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,8"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
              BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#F3F6FB"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>
  <Style TargetType="Button" BasedOn="{StaticResource BaseButton}"/>

  <!-- 主按钮 -->
  <Style x:Key="PrimaryButton" TargetType="Button">
   <Setter Property="Foreground" Value="White"/>
   <Setter Property="Background" Value="{StaticResource Primary}"/>
   <Setter Property="Padding" Value="18,9"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Cursor" Value="Hand"/>
   <Setter Property="SnapsToDevicePixels" Value="True"/>
   <Setter Property="Template">
    <Setter.Value>
     <ControlTemplate TargetType="Button">
      <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
       <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <ControlTemplate.Triggers>
       <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Bd" Property="Background" Value="#2F5FCC"/></Trigger>
       <Trigger Property="IsPressed" Value="True"><Setter TargetName="Bd" Property="Opacity" Value="0.85"/></Trigger>
       <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.4"/></Trigger>
      </ControlTemplate.Triggers>
     </ControlTemplate>
    </Setter.Value>
   </Setter>
  </Style>

  <!-- 侧栏导航 -->
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource BaseButton}">
   <Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/>
   <Setter Property="Padding" Value="12,9"/>
   <Setter Property="Margin" Value="0,1"/>
   <Setter Property="HorizontalContentAlignment" Value="Left"/>
   <Setter Property="FontSize" Value="13"/>
  </Style>
  <Style x:Key="NavActive" TargetType="Button" BasedOn="{StaticResource NavButton}">
   <Setter Property="Background" Value="{StaticResource PrimarySoft}"/>
   <Setter Property="Foreground" Value="{StaticResource Primary}"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
  </Style>

  <!-- 卡片 -->
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="White"/>
   <Setter Property="CornerRadius" Value="12"/>
   <Setter Property="BorderBrush" Value="{StaticResource Line}"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="20"/>
  </Style>

  <Style x:Key="SectionTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="15"/>
   <Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#232A35"/>
   <Setter Property="Margin" Value="0,0,0,6"/>
  </Style>
  <Style x:Key="Hint" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11.5"/>
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="TextWrapping" Value="Wrap"/>
   <Setter Property="LineHeight" Value="18"/>
  </Style>
  <Style x:Key="FieldLabel" TargetType="TextBlock">
   <Setter Property="FontSize" Value="11.5"/>
   <Setter Property="Foreground" Value="{StaticResource Muted}"/>
   <Setter Property="Margin" Value="1,0,0,5"/>
  </Style>

  <Style TargetType="TextBox">
   <Setter Property="Padding" Value="9,7"/>
   <Setter Property="BorderBrush" Value="#DDE3EC"/>
   <Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Background" Value="#FBFCFE"/>
   <Setter Property="Foreground" Value="#1F2430"/>
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ComboBox">
   <Setter Property="FontSize" Value="13"/>
   <Setter Property="Padding" Value="8,5"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="CheckBox">
   <Setter Property="FontSize" Value="12"/>
   <Setter Property="Foreground" Value="#55606E"/>
   <Setter Property="VerticalContentAlignment" Value="Center"/>
  </Style>
  <Style TargetType="ListViewItem">
   <Setter Property="Padding" Value="6,5"/>
   <Setter Property="BorderThickness" Value="0"/>
  </Style>
  <Style TargetType="Expander">
   <Setter Property="Foreground" Value="#232A35"/>
   <Setter Property="FontSize" Value="13"/>
  </Style>
 </Window.Resources>

 <Grid>
  <Grid.ColumnDefinitions>
   <ColumnDefinition Width="216"/>
   <ColumnDefinition Width="*"/>
  </Grid.ColumnDefinitions>

  <!-- ================= 侧栏 ================= -->
  <Border Grid.Column="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
   <DockPanel Margin="14,20,14,16">
    <StackPanel DockPanel.Dock="Top">
     <StackPanel Orientation="Horizontal" Margin="6,0,0,22">
      <Border Width="30" Height="30" CornerRadius="8" Background="{StaticResource Primary}">
       <TextBlock Text="X" Foreground="White" FontSize="16" FontWeight="Bold"
                  HorizontalAlignment="Center" VerticalAlignment="Center"/>
      </Border>
      <StackPanel VerticalAlignment="Center" Margin="10,0,0,0">
       <TextBlock Text="X 启动器" FontSize="14" FontWeight="SemiBold"/>
       <TextBlock Text="Minecraft Java" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,1,0,0"/>
      </StackPanel>
     </StackPanel>

     <Button Style="{StaticResource NavActive}" Content="首页"/>
     <Button Style="{StaticResource NavButton}" Content="启动游戏" Click="LaunchPage_Click"/>
     <Button Style="{StaticResource NavButton}" Content="下载游戏" Click="DownloadPage_Click"/>
     <Button Style="{StaticResource NavButton}" Content="已安装版本" Click="LaunchPage_Click"/>
     <Button Style="{StaticResource NavButton}" Content="账户管理" Click="MicrosoftLogin_Click"/>
     <Button Style="{StaticResource NavButton}" Content="模组管理" Click="Mods_Click"/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom">
     <Border Height="1" Background="{StaticResource Line}" Margin="6,0,6,12"/>
     <Button Style="{StaticResource NavButton}" Content="启动器设置" Click="Settings_Click"/>
     <Button Style="{StaticResource NavButton}" Content="打开游戏目录" Click="OpenDirectory_Click"/>
     <TextBlock Text="独立第三方项目 · 非官方" FontSize="10" Foreground="#AEB6C2" Margin="12,10,0,0"/>
    </StackPanel>

    <Grid/><!-- 占位 -->
   </DockPanel>
  </Border>

  <!-- ================= 主区 ================= -->
  <Grid Grid.Column="1">
   <Grid.RowDefinitions>
    <RowDefinition Height="56"/>
    <RowDefinition Height="*"/>
    <RowDefinition Height="46"/>
   </Grid.RowDefinitions>

   <!-- 顶栏 -->
   <Border Grid.Row="0" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1">
    <Grid Margin="28,0">
     <TextBlock Text="首页" FontSize="15" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
      <Ellipse Width="7" Height="7" Fill="#B9C2CE" VerticalAlignment="Center" Margin="0,0,7,0"/>
      <TextBlock x:Name="AccountStatusText" Text="未登录" FontSize="12"
                 Foreground="{StaticResource Muted}" VerticalAlignment="Center"/>
     </StackPanel>
    </Grid>
   </Border>

   <!-- 内容 -->
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="0,0,2,0">
    <StackPanel Margin="28,24,28,26" MaxWidth="1040">

     <!-- 启动卡 -->
     <Border CornerRadius="14" BorderThickness="1" BorderBrush="#DCE7FB" Padding="26,22">
      <Border.Background>
       <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#EDF3FF" Offset="0"/>
        <GradientStop Color="#F8FAFF" Offset="1"/>
       </LinearGradientBrush>
      </Border.Background>
      <Grid>
       <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="Auto"/>
       </Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="MINECRAFT JAVA EDITION" FontSize="10" FontWeight="Bold"
                   Foreground="#7C93B8"/>
        <TextBlock Text="开始新的世界" FontSize="24" FontWeight="SemiBold"
                   Foreground="#1B2A44" Margin="0,7,0,4"/>
        <TextBlock Text="先选版本，再登录账户，然后点右边就能进游戏。" FontSize="12"
                   Foreground="#63748C"/>
        <WrapPanel Margin="0,16,0,0" VerticalAlignment="Center">
         <TextBlock Text="昵称" FontSize="12" Foreground="#63748C" VerticalAlignment="Center" Margin="0,0,7,0"/>
         <TextBox x:Name="PlayerNameText" Width="150" Text="Player"/>
         <TextBlock Text="内存" FontSize="12" Foreground="#63748C" VerticalAlignment="Center" Margin="16,0,7,0"/>
         <ComboBox x:Name="MemoryCombo" Width="96" SelectedIndex="2">
          <ComboBoxItem Content="1024"/><ComboBoxItem Content="2048"/><ComboBoxItem Content="4096"/>
          <ComboBoxItem Content="6144"/><ComboBoxItem Content="8192"/><ComboBoxItem Content="12288"/>
          <ComboBoxItem Content="16384"/>
         </ComboBox>
         <TextBlock Text="MB" FontSize="11" Foreground="#9AA4B1" VerticalAlignment="Center" Margin="6,0,0,0"/>
        </WrapPanel>
       </StackPanel>

       <Button Grid.Column="1" x:Name="LaunchButton" Content="启动游戏"
               Style="{StaticResource PrimaryButton}" Width="164" Height="50"
               FontSize="16" FontWeight="SemiBold" IsEnabled="False"
               VerticalAlignment="Center" Margin="20,0,0,0" Click="Launch_Click"/>
      </Grid>
     </Border>

     <!-- 版本 + 账户 -->
     <Grid Margin="0,16,0,0">
      <Grid.ColumnDefinitions>
       <ColumnDefinition Width="1.3*"/>
       <ColumnDefinition Width="0.86*"/>
      </Grid.ColumnDefinitions>

      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,8,0">
       <StackPanel>
        <TextBlock Text="版本" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="从 Mojang 官方清单拉取，选中后可直接安装。" Style="{StaticResource Hint}"/>
        <WrapPanel Margin="0,14,0,0">
         <Button Content="获取版本列表" Style="{StaticResource PrimaryButton}" Click="LoadVersions_Click"/>
         <Button Content="安装所选" Margin="8,0,0,0" Click="InstallSelected_Click"/>
         <Button Content="安装 Fabric" Margin="8,0,0,0" Click="InstallFabric_Click"/>
        </WrapPanel>
        <CheckBox x:Name="AutoJavaCheck" Content="安装时同时准备对应 Java" IsChecked="True" Margin="2,12,0,0"/>
        <ListView x:Name="VersionsList" Height="242" Margin="0,12,0,0"
                  VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                  ScrollViewer.CanContentScroll="True"
                  Background="#FCFDFE" BorderBrush="{StaticResource Line}" BorderThickness="1">
         <ListView.View>
          <GridView>
           <GridViewColumn Header="版本" DisplayMemberBinding="{Binding Id}" Width="132"/>
           <GridViewColumn Header="类型" DisplayMemberBinding="{Binding Type}" Width="84"/>
           <GridViewColumn Header="发布时间" DisplayMemberBinding="{Binding ReleaseTime}" Width="164"/>
          </GridView>
         </ListView.View>
        </ListView>
       </StackPanel>
      </Border>

      <StackPanel Grid.Column="1" Margin="8,0,0,0">
       <Border Style="{StaticResource Card}">
        <StackPanel>
         <TextBlock Text="账户" Style="{StaticResource SectionTitle}"/>
         <TextBlock Text="正版走 Microsoft 登录；也可以先用离线账户。" Style="{StaticResource Hint}"/>
         <TextBlock Text="OAuth Client ID" Style="{StaticResource FieldLabel}" Margin="1,14,0,5"/>
         <TextBox x:Name="OAuthClientIdText" Text=""/>
         <WrapPanel Margin="0,12,0,0">
          <Button Content="微软登录" Style="{StaticResource PrimaryButton}" Click="MicrosoftLogin_Click"/>
          <Button Content="离线登录" Margin="8,0,0,0" Click="OfflineLogin_Click"/>
          <Button Content="退出" Margin="8,0,0,0" Click="Logout_Click"/>
         </WrapPanel>
        </StackPanel>
       </Border>

       <Border Style="{StaticResource Card}" Margin="0,12,0,0">
        <StackPanel>
         <TextBlock Text="Java 环境" Style="{StaticResource SectionTitle}"/>
         <TextBlock Text="启动时按版本自动匹配 Java 主版本，缺失可自动下载。" Style="{StaticResource Hint}"/>
         <WrapPanel Margin="0,12,0,0">
          <Button Content="检测" Click="DetectJava_Click"/>
          <Button Content="管理中心" Margin="8,0,0,0" Click="JavaManager_Click"/>
         </WrapPanel>
        </StackPanel>
       </Border>
      </StackPanel>
     </Grid>

     <!-- 更多设置（默认收起，减少一屏信息量） -->
     <Expander Margin="0,16,0,0" IsExpanded="False" Foreground="#232A35">
      <Expander.Header>
       <TextBlock Text="更多设置 · Java 手选 / 游戏目录 / 日志" FontSize="12" Foreground="#7A8494"/>
      </Expander.Header>
      <Border Style="{StaticResource Card}" Margin="0,10,0,0">
       <StackPanel>
        <Grid>
         <Grid.ColumnDefinitions>
          <ColumnDefinition Width="*"/>
          <ColumnDefinition Width="Auto"/>
         </Grid.ColumnDefinitions>
         <StackPanel>
          <TextBlock Text="游戏目录" Style="{StaticResource SectionTitle}"/>
          <TextBox x:Name="GameDirectoryText"/>
         </StackPanel>
         <StackPanel Grid.Column="1" VerticalAlignment="Bottom" Margin="12,0,0,0">
          <Button Content="选择目录" Click="ChooseDirectory_Click"/>
         </StackPanel>
        </Grid>

        <TextBlock Text="手动指定 Java 主版本" Style="{StaticResource FieldLabel}" Margin="1,16,0,5"/>
        <WrapPanel>
         <ComboBox x:Name="JavaVersionCombo" Width="86" SelectedIndex="2">
          <ComboBoxItem Content="8"/><ComboBoxItem Content="17"/><ComboBoxItem Content="21"/><ComboBoxItem Content="25"/>
         </ComboBox>
         <Button Content="安装所选 Java" Margin="8,0,0,0" Click="InstallJava_Click"/>
        </WrapPanel>

        <TextBlock Text="启动器日志" Style="{StaticResource FieldLabel}" Margin="1,18,0,5"/>
        <TextBox x:Name="LogText" Height="120" IsReadOnly="True" AcceptsReturn="True"
                 TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                 VerticalContentAlignment="Top" FontSize="11.5" Foreground="#5A6472"
                 Background="#FBFCFE" BorderBrush="{StaticResource Line}" Padding="10,8"/>
       </StackPanel>
      </Border>
     </Expander>

    </StackPanel>
   </ScrollViewer>

   <!-- 底部状态栏：始终可见 -->
   <Border Grid.Row="2" Background="White" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0">
    <Grid Margin="28,0">
     <Grid.ColumnDefinitions>
      <ColumnDefinition Width="*"/>
      <ColumnDefinition Width="Auto"/>
     </Grid.ColumnDefinitions>
     <TextBlock x:Name="StatusText" Text="状态：等待操作" FontSize="12" Foreground="#5E6C80"
                VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
     <ProgressBar Grid.Column="1" x:Name="Progress" Width="190" Height="6"
                  Minimum="0" Maximum="100" VerticalAlignment="Center"
                  Background="#EDF0F5" Foreground="{StaticResource Primary}"/>
    </Grid>
   </Border>
  </Grid>
 </Grid>
</Window>
