<Window x:Class="MC_Launcher_Revival.MainWindow"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 Title="X 启动器" Height="820" Width="1280" MinHeight="720" MinWidth="1020"
 WindowStartupLocation="CenterScreen" Background="#F4F6F9" Foreground="#30343B">
 <Window.Resources>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#333A45"/><Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#D9DEE7"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="14,9"/><Setter Property="Margin" Value="4"/>
   <Setter Property="Cursor" Value="Hand"/><Setter Property="FontSize" Value="13"/>
  </Style>
  <Style x:Key="NavButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
   <Setter Property="HorizontalContentAlignment" Value="Left"/><Setter Property="Background" Value="Transparent"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="16,12"/>
   <Setter Property="Margin" Value="0,2"/><Setter Property="FontSize" Value="14"/>
  </Style>
  <Style x:Key="Card" TargetType="Border">
   <Setter Property="Background" Value="White"/><Setter Property="CornerRadius" Value="9"/>
   <Setter Property="BorderBrush" Value="#E3E7ED"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="20"/>
  </Style>
  <Style x:Key="SectionTitle" TargetType="TextBlock">
   <Setter Property="FontSize" Value="18"/><Setter Property="FontWeight" Value="SemiBold"/>
   <Setter Property="Foreground" Value="#303743"/><Setter Property="Margin" Value="0,0,0,12"/>
  </Style>
 </Window.Resources>
 <Grid>
  <Grid.ColumnDefinitions><ColumnDefinition Width="218"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
  <!-- PCL2-inspired navigation rail -->
  <Border Grid.Column="0" Background="#FFFFFF" BorderBrush="#E2E6EC" BorderThickness="0,0,1,0">
   <DockPanel>
    <StackPanel DockPanel.Dock="Top" Margin="18,22,18,18">
     <TextBlock Text="X 启动器" FontSize="24" FontWeight="Bold" Foreground="#4A82D8"/>
     <TextBlock Text="MINECRAFT LAUNCHER  ·  X EDITION" FontSize="10" Foreground="#929AA7" Margin="1,4,0,22"/>
     <Button Style="{StaticResource NavButton}" Background="#EAF2FF" Foreground="#3977D2" Content="⌂   首页"/>
     <Button Style="{StaticResource NavButton}" Content="▶   启动游戏" Click="LaunchPage_Click"/>
     <Button Style="{StaticResource NavButton}" Content="⇩   下载游戏" Click="DownloadPage_Click"/>
     <Button Style="{StaticResource NavButton}" Content="▣   已安装版本" Click="LaunchPage_Click"/>
     <Button Style="{StaticResource NavButton}" Content="◈   账户管理" Click="MicrosoftLogin_Click"/>
     <Button Style="{StaticResource NavButton}" Content="☕   模组管理" Click="Mods_Click"/>
     <Button Style="{StaticResource NavButton}" Content="⚙   启动器设置" Click="Settings_Click"/>
     <Button Style="{StaticResource NavButton}" Content="📁   打开游戏目录" Click="OpenDirectory_Click"/>
    </StackPanel>
    <StackPanel DockPanel.Dock="Bottom" Margin="18,12,18,20">
     <Separator Background="#E5E8ED"/>
     <TextBlock Text="X Launcher · Minecraft 启动器" Foreground="#929AA7" FontSize="10" Margin="0,12,0,2"/>
     <TextBlock Text="独立第三方项目" Foreground="#AAB1BC" FontSize="10"/>
    </StackPanel>
   </DockPanel>
  </Border>
  <Grid Grid.Column="1">
   <Grid.RowDefinitions><RowDefinition Height="58"/><RowDefinition Height="*"/></Grid.RowDefinitions>
   <Border Grid.Row="0" Background="#FFFFFF" BorderBrush="#E2E6EC" BorderThickness="0,0,0,1">
    <Grid Margin="24,0">
     <TextBlock Text="首页" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center"/>
     <TextBlock x:Name="AccountStatusText" Text="账户：未登录" Foreground="#6F7886" VerticalAlignment="Center" HorizontalAlignment="Right"/>
    </Grid>
   </Border>
   <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
    <StackPanel Margin="28,24,28,30">
     <TextBlock Text="欢迎回来" FontSize="27" FontWeight="SemiBold" Foreground="#303743"/>
     <TextBlock Text="选择游戏版本，管理账户与游戏文件，然后开始游戏。" FontSize="13" Foreground="#858E9B" Margin="0,6,0,18"/>
     <!-- Home launch hero -->
     <Border Background="#EAF2FF" CornerRadius="10" Padding="24" BorderBrush="#D5E4FA" BorderThickness="1">
      <Grid>
       <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
       <StackPanel VerticalAlignment="Center">
        <TextBlock Text="MINECRAFT JAVA EDITION" Foreground="#5B83BC" FontSize="10" FontWeight="Bold"/>
        <TextBlock Text="准备好开始新世界了吗？" FontSize="23" FontWeight="SemiBold" Foreground="#2E405A" Margin="0,8,0,5"/>
        <TextBlock Text="在下方选择已安装的版本。首次安装需要网络连接。" Foreground="#65758B" FontSize="12"/>
        <WrapPanel Margin="-4,14,0,0">
         <TextBlock Text="游戏昵称" VerticalAlignment="Center" Foreground="#526174" Margin="4"/>
         <TextBox x:Name="PlayerNameText" Width="160" Padding="8" Text="Player" Background="White" BorderBrush="#CCD7E5"/>
         <TextBlock Text="内存" VerticalAlignment="Center" Foreground="#526174" Margin="10,4,4,4"/>
         <ComboBox x:Name="MemoryCombo" Width="100" SelectedIndex="2" Padding="5" Background="White" Foreground="#303743">
          <ComboBoxItem Content="1024"/><ComboBoxItem Content="2048"/><ComboBoxItem Content="4096"/><ComboBoxItem Content="6144"/><ComboBoxItem Content="8192"/><ComboBoxItem Content="12288"/><ComboBoxItem Content="16384"/>
         </ComboBox>
        </WrapPanel>
       </StackPanel>
       <Button Grid.Column="1" x:Name="LaunchButton" Content="▶  启动游戏" Width="168" Height="54" FontSize="17" FontWeight="SemiBold" Foreground="White" Background="#4B83D6" BorderThickness="0" VerticalAlignment="Center" Click="Launch_Click" IsEnabled="False"/>
      </Grid>
     </Border>
     <Grid Margin="0,18,0,0">
      <Grid.ColumnDefinitions><ColumnDefinition Width="1.35*"/><ColumnDefinition Width="0.9*"/></Grid.ColumnDefinitions>
      <Border Grid.Column="0" Style="{StaticResource Card}" Margin="0,0,9,0">
       <StackPanel>
        <TextBlock Text="版本选择" Style="{StaticResource SectionTitle}"/>
        <TextBlock Text="获取官方版本列表，选择一个版本进行安装或启动。" Foreground="#7E8794" FontSize="12" Margin="0,0,0,12"/>
        <WrapPanel>
         <Button Content="获取官方版本列表" Click="LoadVersions_Click" Background="#4B83D6" Foreground="White" BorderThickness="0"/>
         <Button Content="安装所选版本" Click="InstallSelected_Click"/>
        </WrapPanel>
        <ListView x:Name="VersionsList" Height="265" Background="#FAFBFC" Foreground="#343B46" BorderBrush="#E5E8ED" Margin="0,10,0,0">
         <ListView.View><GridView>
          <GridViewColumn Header="版本" DisplayMemberBinding="{Binding Id}" Width="120"/>
          <GridViewColumn Header="类型" DisplayMemberBinding="{Binding Type}" Width="75"/>
          <GridViewColumn Header="发布时间" DisplayMemberBinding="{Binding ReleaseTime}" Width="150"/>
         </GridView></ListView.View>
        </ListView>
       </StackPanel>
      </Border>
      <StackPanel Grid.Column="1">
       <Border Style="{StaticResource Card}" Margin="9,0,0,10">
        <StackPanel>
         <TextBlock Text="账户登录" Style="{StaticResource SectionTitle}"/>
         <TextBlock Text="正版账户或离线本地账户均可使用。" Foreground="#7E8794" FontSize="12" TextWrapping="Wrap" Margin="0,0,0,8"/>
         <TextBlock Text="Microsoft OAuth Client ID" Foreground="#697484" FontSize="11" Margin="2,4"/>
         <TextBox x:Name="OAuthClientIdText" Padding="8" Background="#FAFBFC" Foreground="#303743" BorderBrush="#D9DEE7"/>
         <WrapPanel Margin="-4,8,0,0">
          <Button Content="微软正版登录" Click="MicrosoftLogin_Click" Background="#4B83D6" Foreground="White" BorderThickness="0"/>
          <Button Content="离线登录" Click="OfflineLogin_Click" Background="#EAF5EE" Foreground="#397C55" BorderBrush="#D0E8D8"/>
          <Button Content="退出" Click="Logout_Click"/>
         </WrapPanel>
        </StackPanel>
       </Border>
       <Border Style="{StaticResource Card}" Margin="9,0,0,0">
        <StackPanel>
         <TextBlock Text="Java 环境" Style="{StaticResource SectionTitle}"/>
         <TextBlock Text="检测本机 Java 运行环境。Java 自动安装器正在开发中，请先确保系统已安装对应版本。" Foreground="#7E8794" FontSize="12" TextWrapping="Wrap"/>
         <WrapPanel Margin="-4,8,0,0"><Button Content="检测 Java" Click="DetectJava_Click"/><Button Content="自动安装 Java 21" Click="InstallJava_Click" Background="#4B83D6" Foreground="White" BorderThickness="0"/></WrapPanel>
        </StackPanel>
       </Border>
      </StackPanel>
     </Grid>
     <Border Style="{StaticResource Card}" Margin="0,18,0,0">
      <StackPanel>
       <TextBlock Text="游戏目录与多线程下载状态" Style="{StaticResource SectionTitle}"/>
       <TextBlock Text="游戏目录" Foreground="#7E8794" FontSize="12" Margin="0,0,0,4"/>
       <DockPanel>
        <Button DockPanel.Dock="Right" Content="选择目录" Click="ChooseDirectory_Click"/>
        <TextBox x:Name="GameDirectoryText" Padding="8" Background="#FAFBFC" Foreground="#303743" BorderBrush="#D9DEE7"/>
       </DockPanel>
       <TextBlock x:Name="StatusText" Text="状态：等待操作" Margin="4,12,4,7" Foreground="#4C78B8" TextWrapping="Wrap"/>
       <ProgressBar x:Name="Progress" Height="10" Minimum="0" Maximum="100" Background="#E9EDF2" Foreground="#4B83D6"/><TextBlock Text="下载引擎：最多 8 个文件并发 · 自动重试 · SHA-1 校验（单文件断点续传仍在开发）" Foreground="#7E8794" FontSize="11" Margin="3,7,0,0"/>
      </StackPanel>
     </Border>
     <Border Style="{StaticResource Card}" Margin="0,18,0,0">
      <StackPanel>
       <TextBlock Text="启动器日志" Style="{StaticResource SectionTitle}"/>
       <TextBox x:Name="LogText" Height="115" IsReadOnly="True" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" Background="#FAFBFC" Foreground="#596575" BorderBrush="#E5E8ED" Padding="8"/>
      </StackPanel>
     </Border>
    </StackPanel>
   </ScrollViewer>
  </Grid>
 </Grid>
</Window>
