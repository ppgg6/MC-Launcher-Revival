<Application x:Class="MC_Launcher_Revival.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#4B83D6"/>
  <SolidColorBrush x:Key="Panel" Color="#FFFFFF"/>
  <SolidColorBrush x:Key="WindowBg" Color="#F4F6F9"/>
  <SolidColorBrush x:Key="Text" Color="#303743"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="#333A45"/><Setter Property="Background" Value="#FFFFFF"/>
   <Setter Property="BorderBrush" Value="#D9DEE7"/><Setter Property="BorderThickness" Value="1"/>
   <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Application.Resources>
</Application>
