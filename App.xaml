<Application x:Class="MC_Launcher_Revival.App"
 xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
 xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
 StartupUri="MainWindow.xaml">
 <Application.Resources>
  <SolidColorBrush x:Key="Accent" Color="#6C9EFF"/>
  <SolidColorBrush x:Key="Panel" Color="#192538"/>
  <SolidColorBrush x:Key="WindowBg" Color="#0D1521"/>
  <SolidColorBrush x:Key="Text" Color="#F1F5FC"/>
  <Style TargetType="Button">
   <Setter Property="Foreground" Value="White"/><Setter Property="Background" Value="#326FE6"/>
   <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="12,8"/>
   <Setter Property="Margin" Value="4"/><Setter Property="Cursor" Value="Hand"/>
  </Style>
 </Application.Resources>
</Application>
